# Copy to .env, fill in the values, then: make plan
# The .env file is gitignored; .env.example is not.
#
# Create the GitLab token at:
#   https://gitlab.com/-/user_settings/personal_access_tokens
#   Scope required: api  (read_api is not enough, Terraform writes the state)
#
# The state lives in the GitLab managed Terraform state of this project:
#   https://gitlab.com/api/v4/projects/85968137/terraform/state/aks-azurefiles

export TF_HTTP_USERNAME=your-gitlab-username
export TF_HTTP_PASSWORD=your-gitlab-token

export TF_VAR_subscription_id=your-azure-subscription-id
